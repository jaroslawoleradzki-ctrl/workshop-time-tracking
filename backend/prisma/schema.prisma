datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String           @id @default(uuid()) @db.Uuid
  username            String           @unique @db.VarChar(50)
  passwordHash        String           @map("password_hash") @db.VarChar(255)
  fullName            String           @map("full_name") @db.VarChar(100)
  role                String           @db.VarChar(20) // "admin" or "leader"
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  createdReports      WorkTimeReport[] @relation("CreatedBy")
  modifiedReports     WorkTimeReport[] @relation("ModifiedBy")
  auditLogs           AuditLog[]
  imports             ImportHistory[]

  @@map("users")
}

model Employee {
  id             String           @id @default(uuid()) @db.Uuid
  fullName       String           @map("full_name") @db.VarChar(150)
  firstName      String?          @map("first_name") @db.VarChar(100)
  lastName       String?          @map("last_name") @db.VarChar(100)
  employeeNumber String?          @map("employee_number") @db.VarChar(50)
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  reports        WorkTimeReport[]

  @@map("employees")
}

model WorkTimeType {
  code          String           @id @db.VarChar(10)
  name          String           @db.VarChar(100)
  requiresOrder Boolean          @default(false) @map("requires_order")
  isSystem      Boolean          @default(false) @map("is_system")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  reports       WorkTimeReport[]

  @@map("work_time_types")
}

enum OrderStatus {
  OPEN
  SUSPENDED
  CLOSED
}

model Order {
  id                  String           @id @default(uuid()) @db.Uuid
  orderNumber         String           @unique @map("order_number") @db.VarChar(50)
  orderDate           DateTime         @map("order_date")
  plannedShipmentDate DateTime?        @map("planned_shipment_date")
  productCode         String?          @map("product_code") @db.VarChar(50)
  productName         String           @map("product_name") @db.VarChar(200)
  accountingAccount   String?          @map("accounting_account") @db.VarChar(50)
  orderedBy           String?          @map("ordered_by") @db.VarChar(100)
  plannedHours        Decimal          @map("planned_hours") @db.Decimal(10, 2)
  quantity            Decimal?         @map("quantity") @db.Decimal(10, 2)
  quantityUnit        String           @default("szt.") @map("quantity_unit") @db.VarChar(20)
  hoursPerUnit        Decimal          @map("hours_per_unit") @db.Decimal(10, 2)
  status              OrderStatus      @default(OPEN)
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at")
  completionDate      DateTime?        @map("completion_date")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  reports           WorkTimeReport[]

  @@map("orders")
}

model WorkTimeReport {
  id                 String       @id @default(uuid()) @db.Uuid
  date               DateTime     @db.Date
  employeeId         String       @map("employee_id") @db.Uuid
  orderId            String?      @map("order_id") @db.Uuid
  hours              Decimal      @db.Decimal(4, 2)
  workTimeTypeCode   String       @map("work_time_type_code") @db.VarChar(10)
  createdByUserId    String       @map("created_by_user_id") @db.Uuid
  modifiedByUserId   String?      @map("modified_by_user_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")

  employee           Employee     @relation(fields: [employeeId], references: [id])
  order              Order?       @relation(fields: [orderId], references: [id])
  workTimeType       WorkTimeType @relation(fields: [workTimeTypeCode], references: [code])
  createdByUser      User         @relation("CreatedBy", fields: [createdByUserId], references: [id])
  modifiedByUser     User?        @relation("ModifiedBy", fields: [modifiedByUserId], references: [id])

  @@map("work_time_reports")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tableName  String   @map("table_name") @db.VarChar(50) // "work_time_reports", "orders", "employees"
  recordId   String   @map("record_id") @db.Uuid
  action     String   @db.VarChar(20) // "CREATE", "UPDATE", "DELETE"
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model ImportHistory {
  id           String   @id @default(uuid()) @db.Uuid
  filename     String   @db.VarChar(255)
  importType   String   @map("import_type") @db.VarChar(50) // "employees", "orders"
  importedById String   @map("imported_by_id") @db.Uuid
  status       String   @db.VarChar(20) // "success", "failed", "partial"
  totalRows    Int      @map("total_rows")
  successRows  Int      @map("success_rows")
  errorRows    Int      @map("error_rows")
  errorsLog    Json?    @map("errors_log")
  createdAt    DateTime @default(now()) @map("created_at")

  importedBy   User     @relation(fields: [importedById], references: [id])

  @@map("import_history")
}
