# Workshop Time Tracking - Docker Compose configuration
#
# Copy this file to .env before the first start:
#   cp .env.example .env
#   chmod 600 .env
#
# Generate URL-safe secrets, for example:
#   openssl rand -hex 32
#
# Required database settings. Keep these values unchanged for an existing
# PostgreSQL volume unless you perform a separate, controlled credential change.
WTT_POSTGRES_USER=time_user
WTT_POSTGRES_PASSWORD=
WTT_POSTGRES_DB=time_reporting

# Required JWT signing secret. Changing it invalidates active user sessions.
WTT_JWT_SECRET=

# Required external volume. Existing production deployments must use the exact
# name reported by `docker volume ls` / `docker volume inspect`.
WTT_POSTGRES_VOLUME=workshop-time-tracking-main_pgdata

# Host-side published ports.
WTT_HTTP_PORT=80
WTT_BACKEND_HOST_PORT=5000
WTT_POSTGRES_HOST_PORT=5432

# Optional backend log level.
WTT_LOG_LEVEL=info
